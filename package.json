{
  "name": "@mirsella/opencode-computer-use-mcp",
  "version": "0.5.2",
  "description": "Computer use on KDE Plasma Wayland, with a bundled Rust MCP server and OpenCode plugin",
  "type": "module",
  "exports": {
    ".": "./plugin/computer-use.mjs",
    "./server": "./plugin/computer-use.mjs"
  },
  "bin": {
    "computer-use-mcp": "vendor/bin/computer-use-mcp"
  },
  "files": [
    "plugin/computer-use.mjs",
    "skills/computer-use-mcp/SKILL.md",
    "vendor/bin/computer-use-mcp",
    "README.md",
    "MCP.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node scripts/package-native.mjs",
    "test": "node --test tests/npm.test.mjs"
  },
  "keywords": ["opencode", "mcp", "computer-use", "wayland", "kde"],
  "homepage": "https://github.com/mirsella/computer-use-mcp#readme",
  "bugs": "https://github.com/mirsella/computer-use-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirsella/computer-use-mcp.git"
  },
  "license": "MIT",
  "author": "mirsella",
  "os": ["linux"],
  "cpu": ["x64"],
  "libc": ["glibc"],
  "engines": {
    "node": ">=22",
    "opencode": ">=1.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
